# Source this file before running Python; no credential belongs here.
ROBOAPI_BASE_URL=https://api.pokebot.com/v1
ROBOAPI_MODEL=poke-aurora-preview
ROBOAPI_WORK=.local/roboapi
ROBOAPI_TOKEN_FILE=.local/roboapi/credentials/api-key
ROBOAPI_RIG_DIR=.local/roboapi/rig
ROBOAPI_PANDA_USD=.local/roboapi/assets/panda_instanceable.usd
ROBOAPI_ASSEMBLY_USD=.local/roboapi/rig/assembly.usdc
ROBOAPI_ASSEMBLY_ROOT=/Robot
ROBOAPI_CAMERA_PRIM=/Robot/poke_wrist_camera_link/WristCamera
ROBOAPI_CALIBRATION=.local/roboapi/rig/camera.json
ROBOAPI_ACTUATOR=.local/roboapi/rig/actuator.json
ROBOAPI_ROBOT_USD=.local/roboapi/rig/franka_robotiq.usd
ROBOAPI_PYTHON=.venv/bin/python
ROBOAPI_DEVICE=cpu
ROBOAPI_RUN_NAME=roboapi_full120_10seeds_120s
